---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import Icon from '../../components/Icon.astro';
import { resources, stats, KIND_LABELS, TIER_LABELS, BADGES, formatDate, isOfficial } from '../../lib/catalog.js';
import { graph, breadcrumbLd, itemListLd, webPageLd } from '../../lib/seo.js';

const list = resources();
const s = stats();
const kinds = [...new Set(list.map((r) => r.kind))];
const title = 'Free AI API tiers and limits catalog';
const description = `${s.resources} free AI and cloud tiers from ${s.providers} providers (LLM APIs, speech, GPU notebooks, credits), each with dated limits, usage rules and sources.`;
const jsonLd = graph([
  webPageLd(Astro.site, { path: '/catalog/', name: title, description, type: 'CollectionPage', dateModified: s.latest }),
  breadcrumbLd(Astro.site, [{ name: 'Home', path: '/' }, { name: 'Catalog', path: '/catalog/' }]),
  itemListLd(Astro.site, { name: title, items: list.map((r) => ({ name: r.name, path: `/resources/${r.id}/` })) }),
]);
---
<Base title={title} current="catalog" description={description} jsonLd={jsonLd}>
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Catalog</p>
      <h1>Free-tier catalog</h1>
      <p class="lede">{s.resources} resources from {s.providers} providers. Every limit is dated and linked to its source.</p>
      <div class="meta-row">
        <span>Catalog version <b class="num">{s.version}</b></span>
        <span>Latest check <b>{formatDate(s.latest)}</b></span>
        <span><b>{s.official}</b> confirmed from official sources</span>
      </div>
    </div>
  </header>

  <div class="page-body">
    <div class="wrap">
      <form class="toolbar" data-filters aria-label="Filter the catalog">
        <label class="search">
          <span class="sr-only">Search</span>
          <Icon name="search" />
          <input type="search" name="q" placeholder="Search Groq, Whisper, credit…" />
        </label>
        <label class="sr-only" for="f-kind">Type</label>
        <select id="f-kind" name="kind">
          <option value="">All types</option>
          {kinds.map((k) => <option value={k}>{KIND_LABELS[k] ?? k}</option>)}
        </select>
        <label class="chip"><input type="checkbox" name="client" /><span>Safe for client work</span></label>
        <label class="chip"><input type="checkbox" name="eu" /><span>Serves EU users</span></label>
        <span class="count" data-count role="status" aria-live="polite"><b>{list.length}</b> shown</span>
      </form>

      <ul class="cards">
        {list.map((r) => (
          <li class="card res-card" data-kind={r.kind} data-badges={r.badges.map((b) => b.type).join(' ')} data-text={`${r.provider} ${r.name} ${(r.models ?? []).join(' ')}`.toLowerCase()}>
            <div class="top">
              <span class="mono-mark" aria-hidden="true">{r.provider[0]}</span>
              <div class="who"><div class="prov">{r.provider} · {KIND_LABELS[r.kind] ?? r.kind}</div></div>
            </div>
            <h3><a href={`/resources/${r.id}/`}>{r.name}</a></h3>
            <div class="facts">
              <span>{TIER_LABELS[r.tier_type] ?? r.tier_type}</span>
              <span>{r.limit_rules.length} limit{r.limit_rules.length === 1 ? '' : 's'}</span>
              <span>Checked {formatDate(r.last_verified)}</span>
            </div>
            <div class="badges">
              {r.badges.map((b) => <Badge type={b.type} />)}
              {isOfficial(r) ? <span class="badge ok">Official source</span> : <span class="badge">Snapshot source</span>}
            </div>
          </li>
        ))}
      </ul>
      <p class="empty" data-empty hidden>No resource matches these filters. Try clearing the search or a filter.</p>
    </div>
  </div>
</Base>

<script>
  // Client-side filtering. Badge rules mirror the agent's policy engine (Chapter 4):
  // client work excludes trains_on_data and non_commercial; EU users exclude eu_restricted.
  const form = document.querySelector<HTMLFormElement>('[data-filters]')!;
  const cards = [...document.querySelectorAll<HTMLElement>('.cards .card')];
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const apply = () => {
    const f = new FormData(form);
    const q = String(f.get('q') || '').trim().toLowerCase();
    const kind = String(f.get('kind') || '');
    let shown = 0;
    for (const c of cards) {
      const badges = (c.dataset.badges || '').split(' ');
      let ok = true;
      if (q && !(c.dataset.text || '').includes(q)) ok = false;
      if (kind && c.dataset.kind !== kind) ok = false;
      if (f.get('client') && (badges.includes('trains_on_data') || badges.includes('non_commercial') || badges.includes('manual_only'))) ok = false;
      if (f.get('eu') && badges.includes('eu_restricted')) ok = false;
      c.hidden = !ok;
      if (ok) shown++;
    }
    count.innerHTML = `<b>${shown}</b> shown`;
    empty.hidden = shown > 0;
  };
  // Deep links from the home page, e.g. /catalog/?kind=llm_api
  const params = new URLSearchParams(location.search);
  const kindSel = form.elements.namedItem('kind') as HTMLSelectElement;
  if (params.get('kind') && [...kindSel.options].some((o) => o.value === params.get('kind'))) kindSel.value = params.get('kind')!;
  if (params.get('q')) (form.elements.namedItem('q') as HTMLInputElement).value = params.get('q')!;
  apply();
  form.addEventListener('input', apply);
  form.addEventListener('submit', (e) => e.preventDefault());
</script>
