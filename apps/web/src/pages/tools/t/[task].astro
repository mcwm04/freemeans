---
// Task page: /tools/t/{task}/, such as "Remove background" (M2). The main search entry for
// people who know the job but not the tool. Same index rule as category pages.
import Base from '../../../layouts/Base.astro';
import ToolList from '../../../components/ToolList.astro';
import { liveTasks, forTask, categoryById, lastModified, MIN_TOOLS_TO_INDEX } from '../../../lib/directory.js';
import { graph, breadcrumbLd, itemListLd, webPageLd } from '../../../lib/seo.js';

export function getStaticPaths() {
  return liveTasks().map((t) => ({ params: { task: t.id }, props: { task: t } }));
}
const { task } = Astro.props;
const list = forTask(task.id);
const cat = categoryById(task.category);
const path = `/tools/t/${task.id}/`;
const title = `${task.name}: free AI tools`;
const description = `${list.length} AI tool${list.length === 1 ? '' : 's'} to ${task.name.charAt(0).toLowerCase() + task.name.slice(1)}, with what each one gives you free: quota, card needed, commercial use.`.slice(0, 170);
const modified = list.map(lastModified).sort().at(-1);
const noindex = list.length < MIN_TOOLS_TO_INDEX;
const jsonLd = graph([
  webPageLd(Astro.site, { path, name: title, description, type: 'CollectionPage', dateModified: modified }),
  breadcrumbLd(Astro.site, [
    { name: 'Home', path: '/' }, { name: 'AI tools', path: '/tools/' },
    ...(cat ? [{ name: cat.name, path: `/tools/c/${cat.id}/` }] : []), { name: task.name, path },
  ]),
  itemListLd(Astro.site, { name: title, items: list.map((t) => ({ name: t.name, path: `/tools/${t.slug}/` })) }),
]);
---
<Base title={title} description={description} jsonLd={jsonLd} current="tools" noindex={noindex}>
  <header class="page-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/tools/">AI tools</a>
        {cat && <><span aria-hidden="true">/</span><a href={`/tools/c/${cat.id}/`}>{cat.name}</a></>}
      </nav>
      <h1>{task.name}</h1>
      <p class="lede">AI tools that can {task.name.charAt(0).toLowerCase() + task.name.slice(1)}, sorted by how much you get free.</p>
    </div>
  </header>
  <div class="page-body">
    <div class="wrap">
      <ToolList tools={list} label={task.name} />
    </div>
  </div>
</Base>
