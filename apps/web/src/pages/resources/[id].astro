---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import Icon from '../../components/Icon.astro';
import {
  resources, KIND_LABELS, BADGES, TIER_LABELS, METRICS, SIGNALS,
  formatValue, formatDate, resetLabel, isOfficial, hostOf,
} from '../../lib/catalog.js';
import WhoCanGet from '../../components/WhoCanGet.astro';
import { graph, breadcrumbLd, webPageLd } from '../../lib/seo.js';
import { liveOffers, offerFacts, groupOf, GROUPS, countryName } from '../../lib/eligibility.js';

export function getStaticPaths() {
  // API free tiers (seed.json) and live eligibility offers. Ended and unverified offers get no page.
  return [...resources(), ...liveOffers()].map((r) => ({ params: { id: r.id }, props: { r } }));
}

const { r } = Astro.props;
const isOffer = Boolean(r.eligibility);
const official = isOffer ? r.sources.every((x) => SIGNALS[x.signal_type]?.official) : isOfficial(r);
// Lead with the numbers people search for ("groq free tier limits"), then the date.
const published = r.limit_rules.filter((l) => formatValue(l) !== 'Not published').slice(0, 2)
  .map((l) => {
    const label = METRICS[l.metric] ?? l.metric;
    if (l.metric === 'credit_usd') return `${formatValue(l)} credit`;
    const unit = /^(.*) \((.+)\)$/.exec(label); // "Session length (hours)" -> "session length 12 hours"
    return unit ? `${unit[1].toLowerCase()} ${formatValue(l)} ${unit[2]}` : `${formatValue(l)} ${label.toLowerCase()}`;
  });
const clamp = (t, max) => (t.length <= max ? t : t.slice(0, t.lastIndexOf(' ', max - 1)).replace(/[ ,.;:]+$/, '') + '…');
const fit = (list, max) => list.find((t) => t.length <= max) ?? clamp(list.at(-1), max);
const facts = isOffer ? offerFacts(r) : null;
const offerDescription = isOffer
  ? clamp(`${r.name}: for ${facts.who.join(', ').toLowerCase()}. ${facts.where}. ${facts.card ? 'Card required. ' : ''}${facts.autoRenews ? 'Charges after the free period. ' : ''}Checked ${formatDate(r.last_verified)}, with sources.`, 170)
  : '';
const description = isOffer ? offerDescription : `Current limits for ${r.name}${published.length ? ': ' + published.join(', ') : ''}. ${r.limit_rules.length} limit${r.limit_rules.length === 1 ? '' : 's'} with sources and usage rules, checked ${formatDate(r.last_verified)}.`;
const title = isOffer
  ? fit([`${r.name}: who can get it`, `${r.name}: eligibility`, r.name], 58)
  : /free|trial|credit/i.test(r.name) ? `${r.name}: limits and rules` : `${r.name}: free tier limits`;
const path = `/resources/${r.id}/`;
const jsonLd = graph([
  webPageLd(Astro.site, {
    path, name: title, description, dateModified: r.last_verified,
    extra: {
      about: {
        '@type': 'Service',
        name: r.name,
        serviceType: KIND_LABELS[r.kind] ?? r.kind,
        provider: { '@type': 'Organization', name: r.provider },
        offers: {
          '@type': 'Offer', price: '0', priceCurrency: 'USD', description: TIER_LABELS[r.tier_type] ?? r.tier_type,
          ...(isOffer && r.eligibility.countries.mode === 'include'
            ? { eligibleRegion: r.eligibility.countries.codes.map((c) => ({ '@type': 'Country', name: countryName(c) })) } : {}),
          ...(r.offer_window?.redeem_by ? { availabilityEnds: r.offer_window.redeem_by } : {}),
        },
      },
    },
  }),
  breadcrumbLd(Astro.site, isOffer
    ? [{ name: 'Home', path: '/' }, { name: 'Free for who you are', path: '/free-for/' }, { name: r.name, path }]
    : [{ name: 'Home', path: '/' }, { name: 'Catalog', path: '/catalog/' }, { name: r.name, path }]),
]);
---
<Base title={title} description={description} jsonLd={jsonLd} current={isOffer ? 'free-for' : 'catalog'}>
  <header class="page-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">{isOffer ? <a href="/free-for/">Free for who you are</a> : <a href="/catalog/">Catalog</a>}<span aria-hidden="true">/</span><span>{r.provider}</span></nav>
      <div class="detail-head">
        <span class="mono-mark lg" aria-hidden="true">{r.provider[0]}</span>
        <div>
          <p class="small muted" style="margin:0 0 6px">{r.provider} · {KIND_LABELS[r.kind] ?? r.kind} · {TIER_LABELS[r.tier_type] ?? r.tier_type}</p>
          <h1>{r.name}</h1>
          <p class="small muted" style="margin:0">Last checked <span class="num">{formatDate(r.last_verified)}</span> · ID <code>{r.id}</code></p>
          {r.badges.length > 0 && <div class="badges">{r.badges.map((b) => <Badge type={b.type} />)}</div>}
        </div>
      </div>
      {official ? (
        <p class="notice ok"><Icon name="shield" /><span>{isOffer ? "Every source below is the provider's own page." : 'Every limit below comes from an official source.'}</span></p>
      ) : (
        <p class="notice"><Icon name="alert" /><span>{isOffer ? "Some sources below are not the provider's own page. Check the provider's page before you rely on this." : "Some limits below come from third-party snapshots, not the provider's own docs. Check the provider's page before you rely on them."}</span></p>
      )}
    </div>
  </header>

  <div class="page-body">
    <div class="wrap detail-layout">
      <div>
        {isOffer && <WhoCanGet r={r} />}
        {r.limit_rules.length > 0 && <section aria-labelledby="limits">
          <h2 id="limits">Limits</h2>
          <div class="table-scroll">
            <table class="ledger">
              <thead><tr><th scope="col">Limit</th><th scope="col">Value</th><th scope="col">Reset</th><th scope="col">Checked</th><th scope="col">Source</th></tr></thead>
              <tbody>
                {r.limit_rules.map((l) => (
                  <tr>
                    <td>{METRICS[l.metric] ?? l.metric}{l.scope && <span class="small muted"> · per {l.scope}</span>}{l.conditions && <div class="small muted">{l.conditions}</div>}</td>
                    <td class="value">{formatValue(l)}</td>
                    <td class="small">{resetLabel(l.reset)}</td>
                    <td class="small num">{formatDate(l.verified_at)}</td>
                    <td class="small"><a href={l.source_url} rel="nofollow noopener">{hostOf(l.source_url)}</a><div class="muted">{SIGNALS[l.signal_type]?.label ?? l.signal_type}</div></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>}

        {r.badges.length > 0 && (
          <section aria-labelledby="rules">
            <h2 id="rules">Usage rules</h2>
            <ul class="rules">
              {r.badges.map((b) => (
                <li><Badge type={b.type} /><div>{BADGES[b.type]?.meaning}{b.note && <> {b.note}</>} <a href={b.source_url} rel="nofollow noopener">Source ({hostOf(b.source_url)})</a></div></li>
              ))}
            </ul>
          </section>
        )}

        {r.models && r.models.length > 0 && (
          <section aria-labelledby="models">
            <h2 id="models">Models</h2>
            <p>{r.models.map((m, i) => <><code>{m}</code>{i < r.models.length - 1 ? ' ' : ''}</>)}</p>
            {r.endpoint && <p class="small muted">Endpoint ({r.endpoint.style.replace(/_/g, ' ')}): <code>{r.endpoint.base_url}</code></p>}
          </section>
        )}

        {r.notes && (
          <section aria-labelledby="notes"><h2 id="notes">Notes</h2><p>{r.notes}</p></section>
        )}

        <section aria-labelledby="sources">
          <h2 id="sources">Sources</h2>
          <ul class="src-list">
            {r.sources.map((src) => (
              <li><a href={src.url} rel="nofollow noopener">{hostOf(src.url)}</a> <span class="small muted">{SIGNALS[src.signal_type]?.label ?? src.signal_type} · fetched {formatDate(src.fetched_at)}</span></li>
            ))}
          </ul>
        </section>
      </div>

      <aside class="aside" aria-label="Summary">
        <div class="panel">
          <h3>At a glance</h3>
          <dl>
            <div><dt>Provider</dt><dd>{r.provider}</dd></div>
            <div><dt>Type</dt><dd>{KIND_LABELS[r.kind] ?? r.kind}</dd></div>
            <div><dt>Plan</dt><dd>{TIER_LABELS[r.tier_type] ?? r.tier_type}</dd></div>
            {!isOffer && <div><dt>Limits tracked</dt><dd class="num">{r.limit_rules.length}</dd></div>}
            {isOffer && <div><dt>For</dt><dd>{groupOf(r).map((g) => GROUPS[g].title).join(', ') || 'Residents'}</dd></div>}
            <div><dt>Sources</dt><dd>{official ? 'Official' : 'Includes snapshots'}</dd></div>
            <div><dt>Last checked</dt><dd>{formatDate(r.last_verified)}</dd></div>
          </dl>
        </div>
        {!isOffer && <div class="panel cta">
          <h3>Track this quota</h3>
          <p>The Freemeans agent watches your usage of {r.provider} and warns you before you hit the limit.</p>
          <a class="btn" href="/#waitlist">Join the beta</a>
        </div>}
      </aside>
    </div>
  </div>
</Base>
