---
// One tool in a list. data-* attributes feed the in-page filters and sort (ToolList.astro).
import { FREE_TYPES, freeSummary, filterFlags, generosity, categoryById } from '../lib/directory.js';
import { formatDate } from '../lib/catalog.js';
interface Props { tool: any }
const { tool } = Astro.props;
const ft = FREE_TYPES[tool.free_tier.type];
const cat = categoryById(tool.categories[0]);
---
<li class="card tool-card"
  data-flags={filterFlags(tool)}
  data-platforms={tool.platforms.join(' ')}
  data-name={tool.name.toLowerCase()}
  data-generosity={generosity(tool)}
  data-listed={tool.listed_at}
  data-text={`${tool.name} ${tool.tagline} ${tool.tasks.join(' ')} ${tool.categories.join(' ')}`.toLowerCase()}>
  <div class="top">
    <span class="mono-mark" aria-hidden="true">{tool.name[0]}</span>
    <div class="who"><div class="prov">{cat?.name ?? ''}</div></div>
  </div>
  <h3><a href={`/tools/${tool.slug}/`}>{tool.name}</a></h3>
  <p class="tagline">{tool.tagline}</p>
  <div class="badges">
    <span class={`badge ${ft.tone}`}>{freeSummary(tool)}</span>
    {tool.free_tier.card_required === false && <span class="badge ok">No card</span>}
  </div>
  <div class="facts"><span>Checked {formatDate(tool.free_tier.verified_at)}</span></div>
</li>
