---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { SITE_NAME, DEFAULT_IMAGE } from '../lib/seo.js';

interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'catalog' | 'tools' | 'free-for' | 'learn';
  // One schema.org JSON-LD object (use graph() from lib/seo.js to combine several).
  jsonLd?: object;
  // true for pages that must stay out of search results (404, previews, thin pages).
  noindex?: boolean;
  ogType?: 'website' | 'article';
  image?: { path: string; width: number; height: number; alt: string };
}
const {
  title,
  description = 'Top AI tools and free resources for every task, for everyone. Every free plan, trial and quota dated and sourced, so you pay only when you must.',
  current,
  jsonLd,
  noindex = false,
  ogType = 'website',
  image = DEFAULT_IMAGE,
} = Astro.props;
const fullTitle = title === SITE_NAME ? 'Freemeans: Do more. Pay nothing.' : `${title} · ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image.path, Astro.site).href;
const year = new Date().getFullYear();
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />
    <meta name="theme-color" content="#F5F3EE" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F1512" media="(prefers-color-scheme: dark)" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/" aria-label="Freemeans home"><Logo /></a>
        <nav class="site-nav" aria-label="Main">
          <a href="/tools/" aria-current={current === 'tools' ? 'page' : undefined}>AI tools</a>
          <a class="opt" href="/learn/" aria-current={current === 'learn' ? 'page' : undefined}>Learn</a>
          <a class="opt-sm" href="/free-for/" aria-current={current === 'free-for' ? 'page' : undefined}>Free for you</a>
          <a class="opt-sm" href="/catalog/" aria-current={current === 'catalog' ? 'page' : undefined}>Catalog</a>
          <a class="opt" href="/#how">How it works</a>
          <a class="opt" href="/#trust">Sources</a>
          <a class="btn sm" href="/#waitlist">Join the beta</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <a class="logo" href="/" aria-label="Freemeans home"><Logo /></a>
            <p class="blurb">Top AI tools and free resources for every task, for everyone. Every free plan, trial and quota dated and sourced, so you pay only when you must.</p>
            <p class="urdu" lang="ur" dir="rtl">کام زیادہ، خرچ صفر</p>
          </div>
          <div>
            <h4>Product</h4>
            <ul>
              <li><a href="/tools/">AI tools directory</a></li>
              <li><a href="/free-for/">Free for who you are</a></li>
              <li><a href="/learn/">Free courses and certificates</a></li>
              <li><a href="/in/pakistan/">Free in Pakistan</a></li>
              <li><a href="/catalog/">Free-tier catalog</a></li>
              <li><a href="/#how">How it works</a></li>
              <li><a href="/#waitlist">Join the beta</a></li>
              <li><a href="/catalog.json">catalog.json</a></li>
            </ul>
          </div>
          <div>
            <h4>Company</h4>
            <ul>
              <li><a href="https://tekdigix.com">TEKDIGIX</a></li>
              <li><a href="mailto:hello@freemeans.com">hello@freemeans.com</a></li>
              <li><a href="https://github.com/mcwm04/freemeans">GitHub</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-legal">
          <p>Freemeans gives information, not a guarantee: providers can change free tiers without notice. Every limit links to its source and the date we checked it. One account per provider. Freemeans never pools accounts or bypasses limits.</p>
          <p>© {year} Freemeans · A <a href="https://tekdigix.com">TEKDIGIX</a> product</p>
        </div>
      </div>
    </footer>
  </body>
</html>
