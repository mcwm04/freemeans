{
  "name": "@freemeans/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "freemeans.com: static Astro site built from the Freemeans catalog, hosted on Cloudflare Pages.",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && astro dev",
    "build": "npm run tokens && astro build",
    "preview": "astro preview",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "astro": "^7.4.7"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  }
}
